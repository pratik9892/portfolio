# Copy to .env and fill in. .env is gitignored.

# Host port for the site (change if 8080 is taken, e.g. by another project's container)
WEB_PORT=8080

# Required for the ngrok service: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: raises GitHub API rate limit during the build (read-only, no scopes needed)
GITHUB_TOKEN=

# Phase 2 (backend profile)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
